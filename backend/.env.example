# All optional — the prototype runs with no configuration and no API keys.
# SQLite location (default: backend/app/database/wbw.db)
WBW_DATABASE_URL=sqlite:///app/database/wbw.db
# Set to 0 to start with an empty database instead of the demo assessments.
WBW_SEED_DEMO=1
# Allowed browser origins when the frontend is not served through the Vite proxy.
WBW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Secret used to sign sign-in tokens. Set a long random value in production (e.g. on Vercel).
# Every server instance must use the same value, or users are signed out when a request hits another instance.
WBW_SECRET_KEY=change-me-to-a-long-random-string
